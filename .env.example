# .env OPCIONAL, so para desenvolvimento (regra 12 do CLAUDE.md): o app
# instalado nao le .env nenhum. Copie para .env para sobrescrever defaults ao
# rodar `make run`. Nunca versione o .env real.

# Log (INFO | DEBUG | WARNING ...) do shell e do servidor local
LOG_LEVEL=INFO
# SQL_LOG_LEVEL=DEBUG

# Marca (backend)
BRAND_NAME=PhotoEditor
# URL do software, gravada no EXIF (Software) das fotos exportadas
# BRAND_URL=https://github.com/helviojunior/photo-editor

# Fuso das datas de captura sem offset no EXIF
TIME_ZONE=America/Sao_Paulo
